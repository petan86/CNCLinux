# OpenCNC Web: příkazy, které webová aplikace smí spouštět jako root (nic dalšího).
@USER@ ALL=(root) NOPASSWD: /usr/bin/apt-get update
@USER@ ALL=(root) NOPASSWD: /usr/bin/apt-get -y upgrade
@USER@ ALL=(root) NOPASSWD: /usr/bin/cyclictest *
@USER@ ALL=(root) NOPASSWD: /usr/bin/halcompile --install *
@USER@ ALL=(root) NOPASSWD: /usr/sbin/reboot
@USER@ ALL=(root) NOPASSWD: /usr/sbin/poweroff
